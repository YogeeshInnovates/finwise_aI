APP_NAME=FinWise AI
ENV=production
SECRET_KEY=replace-with-a-long-random-production-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_DB=finwise
POSTGRES_USER=finwise
POSTGRES_PASSWORD=replace-with-a-strong-database-password

DATABASE_URL=postgresql+psycopg2://finwise:replace-with-a-strong-database-password@postgres:5432/finwise
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_EXTRACT_MODEL=llama-3.1-8b-instant
PINECONE_API_KEY=
PINECONE_INDEX=finwise-plans

CORS_ORIGINS=https://your-frontend-domain.example
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=20
BACKEND_PORT=8000
BACKEND_IMAGE=finwise-backend:latest
